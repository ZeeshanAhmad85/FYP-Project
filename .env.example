# ==========================================
# Rezlink - Environment Configuration Template
# ==========================================

# Application Base URL
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# AI Backend Service (ATS Resume Scoring & AI Section Generator)
NEXT_PUBLIC_API_URL=https://api.rezlink.example.com

# AWS S3 Storage Configuration
NEXT_AWS_S3_REGION=us-east-1
NEXT_AWS_S3_ACCESS_KEY_ID=your_aws_access_key_id
NEXT_AWS_S3_SECRET_ACCESS_KEY=your_aws_secret_access_key
NEXT_AWS_S3_BUCKET_NAME=your_s3_bucket_name